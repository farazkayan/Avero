VITE_SUPABASE_URL=https://your-project.supabase.co

VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

VITE_LOCATIONIQ_API_KEY=your_locationiq_api_key

# CARTO Basemaps API key (powers both light + dark map tiles).
# CARTO requires a `key` query param on Basemaps requests. Get a key at
# https://carto.com/basemaps and set this var in .env (local) and in
# your deployment environment. If unset, tile requests fall back to
# anonymous (still works for low-traffic local dev, but rate-limited).
VITE_CARTO_API_KEY=your_carto_api_key