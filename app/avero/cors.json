[
  {
    "corsRuleName": "downloadFromAnyOrigin",
    "allowedOrigins": ["*"],
    "allowedOperations": ["b2_download_file_by_id", "b2_download_file_by_name"],
    "allowedHeaders": ["authorization", "range"],
    "maxAgeSeconds": 3600
  },
  {
    "corsRuleName": "s3DownloadFromAnyOrigin",
    "allowedOrigins": ["*"],
    "allowedOperations": ["s3_head", "s3_get"],
    "allowedHeaders": ["authorization", "range"],
    "maxAgeSeconds": 3600
  },
  {
    "corsRuleName": "s3UploadFromWebApp",
    "allowedOrigins": [
      "http://localhost:5173",
      "https://withavero.pages.dev",
      "https://*.avero.pages.dev"
    ],
    "allowedOperations": ["s3_put", "s3_head", "s3_get"],
    "allowedHeaders": ["*"],
    "exposeHeaders": ["ETag"],
    "maxAgeSeconds": 3600
  }
]